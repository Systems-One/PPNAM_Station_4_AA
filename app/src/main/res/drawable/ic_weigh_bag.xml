<!--
  Weigh Bag tile icon: a balance scale. Station 4 owns the scale and performs the measurement; the
  handheld only asks (contract 5.1.0 §9.2). Flat white, matching Station 1's dashboard art.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="80dp"
    android:height="80dp"
    android:viewportWidth="48"
    android:viewportHeight="48"
    android:tint="#FFFFFF">

    <!-- Central column and base -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M24,10 L24,38" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M16,40 L32,40" />

    <!-- Beam -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M9,14 L39,14" />

    <!-- Pivot -->
    <path android:fillColor="#FFFFFF" android:pathData="M24,8 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    <!-- Left pan -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M3,26 L9,14 L15,26 A6,6 0 0,1 3,26 Z" />

    <!-- Right pan -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M33,26 L39,14 L45,26 A6,6 0 0,1 33,26 Z" />
</vector>
